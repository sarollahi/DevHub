DATABASE_URL="postgresql://devhub:devhub@localhost:5432/devhub?schema=public"
REDIS_URL="redis://localhost:6379"
BOOTSTRAP_USER_PASSWORD="replace-with-a-unique-strong-password"
BOOTSTRAP_AGENT_TOKEN="replace-with-a-separate-32-character-agent-secret"
OUTBOX_BATCH_SIZE=50
WORKER_CONCURRENCY=4
INGEST_PER_AGENT_PER_MINUTE=120
MAX_ACTIVE_PRS_PER_REPOSITORY=2000
NEXT_PUBLIC_APP_NAME="DevHub"

# Local development only; configure dedicated per-environment credentials in deployments.
OBJECT_STORE_ENDPOINT="http://127.0.0.1:9000"
OBJECT_STORE_BUCKET="devhub-objects"
OBJECT_STORE_REGION="us-east-1"
OBJECT_STORE_ACCESS_KEY="devhub-local"
OBJECT_STORE_SECRET_KEY="devhub-local-password-change-in-production"
OBJECT_STORE_TIMEOUT_MS=30000

# Native review worker
DEVHUB_REVIEW_CONCURRENCY=4
# Optional generic chat completion and embedding endpoints:
# DEVHUB_REVIEW_ENDPOINT=https://example.invalid/v1/chat/completions
# DEVHUB_REVIEW_MODEL=review-model
# DEVHUB_REVIEW_API_KEY=secret
# DEVHUB_REVIEW_EMBEDDING_ENDPOINT=https://example.invalid/v1/embeddings
# DEVHUB_REVIEW_EMBEDDING_MODEL=embedding-model
DEVHUB_REVIEW_SEND_SOURCE=false
DEVHUB_REVIEW_USD_PER_MILLION_TOKENS=0
