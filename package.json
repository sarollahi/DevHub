{
  "name": "devhub",
  "private": true,
  "type": "module",
  "version": "0.1.0",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "tsx scripts/seed.ts",
    "worker": "tsx src/workers/processor.ts",
    "validation:runner": "tsx src/validation/worker.ts",
    "dispatcher": "tsx src/workers/dispatcher.ts",
    "stress:ingest": "tsx scripts/burst.ts",
    "test": "node --import tsx --test tests/*.test.mjs",
    "test:integration": "tsx --test tests/*.integration.test.ts",
    "storage:maintain": "tsx scripts/object-maintain.ts",
    "storage:stress": "tsx scripts/storage-stress.ts",
    "worker:source-index": "tsx src/workers/query-indexer.ts",
    "bench:derived-index": "tsx scripts/bench-derived-index.ts",
    "bench:source-query": "tsx scripts/bench-source-query.ts",
    "cache:serve": "node src/cache/daemon.mjs",
    "cache:benchmark": "node scripts/benchmark-cache.mjs",
    "import:git": "tsx scripts/git-import.ts",
    "import:worker": "tsx scripts/git-import-worker.ts",
    "worker:review": "tsx src/review/source-review.ts",
    "worker:integration": "tsx src/integration/worker.ts",
    "worker:deployment": "tsx src/deployment/worker.ts",
    "bench:integration": "node --experimental-strip-types scripts/bench-integration.mjs",
    "bench:integration:db": "tsx scripts/bench-integration-db.ts",
    "git:gateway": "tsx scripts/git-interop-server.ts",
    "bench:git-interop": "tsx scripts/bench-git-interoperability.ts",
    "bench:lifecycle": "tsx scripts/bench-lifecycle.ts",
    "bench:publication": "tsx scripts/bench-publication.ts",
    "ops:reconcile": "tsx scripts/reconcile.ts",
    "ops:usage": "tsx scripts/tenant-usage.ts",
    "ops:cache-exporter": "node scripts/cache-exporter.mjs",
    "ops:fault-drill": "node scripts/fault-drill.mjs",
    "bench:snapshot-scale": "tsx scripts/bench-snapshot-scale.ts",
    "snapshot:backfill": "tsx scripts/backfill-snapshots.ts",
    "bench:related-review": "node --experimental-strip-types scripts/bench-related-review.mjs",
    "bench:related-db": "tsx scripts/bench-related-review-db.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.0",
    "bullmq": "^5.58.0",
    "ioredis": "^5.4.2",
    "next": "16.4.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "prisma": "6.19.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0"
  }
}
