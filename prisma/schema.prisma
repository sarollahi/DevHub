generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AgentStatus {
  ACTIVE
  SUSPENDED
  REVOKED
}
enum PullRequestState {
  QUEUED
  RUNNING
  BLOCKED
  FAILED
  REVIEW_REQUIRED
  APPROVED
  MERGING
  MERGED
  CLOSED
}
enum JobState {
  QUEUED
  RUNNING
  SUCCEEDED
  FAILED
  CANCELLED
}
enum OutboxState {
  PENDING
  PUBLISHED
}
enum CheckState {
  PENDING
  RUNNING
  SUCCESS
  FAILURE
  CANCELLED
}
enum ReviewState {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
}
enum RiskTier {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}
enum MergeState {
  PENDING
  VALIDATING
  READY
  MERGING
  MERGED
  BLOCKED
  FAILED
}
enum ApprovalDecision {
  APPROVED
  CHANGES_REQUESTED
}

model User {
  id            String          @id @default(uuid()) @db.Uuid
  handle        String          @unique
  email         String          @unique
  createdAt     DateTime        @default(now())
  repositories  Repository[]    @relation("RepoOwner")
  agents        AgentIdentity[] @relation("AgentOwner")
  approvals     Approval[]
  sourceApprovals SourceChangeApproval[]
  passwordHash String?
  disabledAt DateTime?
  sessions HumanSession[]
  memberships OrganizationMembership[]
  teamMemberships TeamMembership[]
}

model Repository {
  id                    String              @id @default(uuid()) @db.Uuid
  ownerId               String              @db.Uuid
  slug                  String
  name                  String
  defaultBranch         String              @default("main")
  maxActivePullRequests Int                 @default(2000)
  requireHumanApproval  Boolean             @default(true)
  createdAt             DateTime            @default(now())
  owner                 User                @relation("RepoOwner", fields: [ownerId], references: [id])
  pullRequests          PullRequest[]
  fingerprints          ChangeFingerprint[]
  mergeGroups           MergeGroup[]
  ingressBuckets        IngressBucket[]
  snapshotRoots         SourceSnapshotRoot[]
  sourceChangesets      SourceChangeset[]
  sourceReferences      SourceReference[]
  blobLeases            BlobLease[]
  blobTransfers         BlobTransfer[]
  sourceReferencePolicies SourceReferencePolicy[]
  sourceRefMutations    SourceRefMutation[]
  queryIndexJobs        SourceQueryIndexJob[]
  sourceObjectGrants    SourceObjectGrant[]
  sourceEvents          SourceChangesetEvent[]
  sourcePublicationKeys SourcePublicationKey[]
  validationPipelines ValidationPipeline[]
  gitImportJobs GitImportJob[]
  gitImportCommits GitImportCommit[]
  gitImportBlobs GitImportBlob[]
  sourceReviews SourceReviewRequest[]
  sourceUploads SourceObjectUpload[]
  organizationId String? @db.Uuid
  maxStoredBytes BigInt @default(1073741824)
  storedBytes BigInt @default(0)
  organization Organization? @relation(fields: [organizationId], references: [id])
  accessGrants RepositoryGrant[]
  delegations AgentDelegation[]
  rateBuckets ApiRateBucket[]
  integrations ChangeIntegration[]
  integrationPolicies IntegrationPolicy[]
  deployments DeploymentExecution[]
  @@unique([ownerId, slug])
  @@index([slug])
}

model AgentIdentity {
  id           String            @id @default(uuid()) @db.Uuid
  ownerId      String            @db.Uuid
  name         String
  status       AgentStatus       @default(ACTIVE)
  scopes       String[]
  createdAt    DateTime          @default(now())
  owner        User              @relation("AgentOwner", fields: [ownerId], references: [id])
  credentials  AgentCredential[]
  pullRequests PullRequest[]
  ingressBuckets IngressBucket[]
  delegations AgentDelegation[]
  @@unique([ownerId, name])
}

model AgentCredential {
  id          String        @id @default(uuid()) @db.Uuid
  agentId     String        @db.Uuid
  tokenHash   String        @unique @db.Char(64)
  label       String
  expiresAt   DateTime?
  revokedAt   DateTime?
  createdAt   DateTime      @default(now())
  agent       AgentIdentity @relation(fields: [agentId], references: [id], onDelete: Cascade)
  scopes String[] @default([])
  @@index([agentId, revokedAt])
}

model PullRequest {
  id             String            @id @default(uuid()) @db.Uuid
  repositoryId   String            @db.Uuid
  agentId        String            @db.Uuid
  idempotencyKey String
  requestHash    String            @db.Char(64)
  title          String
  description    String            @default("")
  sourceBranch   String
  sourceSha      String            @db.VarChar(40)
  targetBranch   String
  targetSha      String            @db.VarChar(40)
  patch          String            @db.Text
  nativeChangesetId String?        @db.Char(64)
  changedFiles   String[]
  state          PullRequestState  @default(QUEUED)
  riskTier       RiskTier?
  riskScore      Int?
  version        Int               @default(1)
  approvedAt     DateTime?
  mergedAt       DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  repository     Repository        @relation(fields: [repositoryId], references: [id])
  agent          AgentIdentity     @relation(fields: [agentId], references: [id])
  checks         CheckRun[]
  reviews        ReviewRun[]
  jobs           QueueJob[]
  fingerprints   ChangeFingerprint[]
  approvals      Approval[]
  mergeGroupItems MergeGroupItem[]
  @@unique([agentId, idempotencyKey])
  @@index([repositoryId, state, createdAt(sort: Desc)])
  @@index([repositoryId, targetBranch, riskScore, createdAt])
  @@index([state, updatedAt])
}

model CheckRun {
  id        String       @id @default(uuid()) @db.Uuid
  pullId    String       @db.Uuid
  name      String
  state     CheckState   @default(PENDING)
  summary   String?
  logUri    String?
  startedAt DateTime?
  endedAt   DateTime?
  createdAt DateTime     @default(now())
  pull      PullRequest  @relation(fields: [pullId], references: [id], onDelete: Cascade)
  @@index([pullId, name, createdAt])
}

model ReviewRun {
  id          String      @id @default(uuid()) @db.Uuid
  pullId      String      @db.Uuid
  model       String
  state       ReviewState @default(QUEUED)
  findings    Json?
  costMicros  BigInt      @default(0)
  startedAt   DateTime?
  completedAt DateTime?
  pull        PullRequest @relation(fields: [pullId], references: [id], onDelete: Cascade)
  @@index([pullId, state])
}

model QueueJob {
  id             String       @id @default(uuid()) @db.Uuid
  pullId         String       @db.Uuid
  kind           String
  idempotencyKey String       @unique
  state          JobState     @default(QUEUED)
  attempts       Int          @default(0)
  maxAttempts    Int          @default(5)
  lastError      String?
  scheduledAt    DateTime     @default(now())
  startedAt      DateTime?
  leaseUntil     DateTime?
  leaseToken     String?      @db.Uuid
  finishedAt     DateTime?
  createdAt      DateTime     @default(now())
  pull           PullRequest  @relation(fields: [pullId], references: [id], onDelete: Cascade)
  @@index([state, scheduledAt])
}

model ChangeFingerprint {
  id           String      @id @default(uuid()) @db.Uuid
  repositoryId String      @db.Uuid
  pullId       String      @db.Uuid
  sha256       String      @db.Char(64)
  fileSetHash  String      @db.Char(64)
  relatedCount Int         @default(0)
  createdAt    DateTime    @default(now())
  repository   Repository  @relation(fields: [repositoryId], references: [id])
  pull         PullRequest @relation(fields: [pullId], references: [id], onDelete: Cascade)
  @@unique([pullId])
  @@index([repositoryId, sha256])
  @@index([repositoryId, fileSetHash])
}

model MergeGroup {
  id           String           @id @default(uuid()) @db.Uuid
  repositoryId String           @db.Uuid
  targetBranch String
  state        MergeState       @default(PENDING)
  createdAt    DateTime         @default(now())
  repository   Repository       @relation(fields: [repositoryId], references: [id])
  items        MergeGroupItem[]
  @@index([repositoryId, targetBranch, state])
}

model MergeGroupItem {
  mergeGroupId String      @db.Uuid
  pullId       String      @db.Uuid
  position     Int
  mergeGroup   MergeGroup  @relation(fields: [mergeGroupId], references: [id], onDelete: Cascade)
  pull         PullRequest @relation(fields: [pullId], references: [id])
  @@id([mergeGroupId, pullId])
  @@unique([mergeGroupId, position])
}

model Approval {
  id        String           @id @default(uuid()) @db.Uuid
  pullId    String           @db.Uuid
  userId    String           @db.Uuid
  version   Int
  decision  ApprovalDecision
  createdAt DateTime         @default(now())
  pull      PullRequest      @relation(fields: [pullId], references: [id], onDelete: Cascade)
  user      User             @relation(fields: [userId], references: [id])
  @@unique([pullId, userId, version])
}

model IngressBucket {
  repositoryId String        @db.Uuid
  agentId      String        @db.Uuid
  minute       DateTime
  count        Int           @default(0)
  repository   Repository    @relation(fields: [repositoryId], references: [id])
  agent        AgentIdentity @relation(fields: [agentId], references: [id])
  @@id([repositoryId, agentId, minute])
}

model OutboxEvent {
  id            String      @id @default(uuid()) @db.Uuid
  aggregateType String
  aggregateId   String      @db.Uuid
  kind          String
  payload       Json
  state         OutboxState @default(PENDING)
  attempts      Int         @default(0)
  nextAttemptAt DateTime    @default(now())
  lockedUntil   DateTime?
  publishedAt   DateTime?
  createdAt     DateTime    @default(now())
  @@index([state, nextAttemptAt, createdAt])
  @@index([aggregateType, aggregateId])
}

model AuditEvent {
  id          String   @id @default(uuid()) @db.Uuid
  repositoryId String? @db.Uuid
  actorType   String
  actorId     String
  action      String
  subjectId   String?
  metadata    Json?
  occurredAt  DateTime @default(now())
  @@index([repositoryId, occurredAt(sort: Desc)])
  @@index([actorType, actorId, occurredAt(sort: Desc)])
}


enum SourceObjectKind {
  BLOB
  TREE
}

enum SourceRefKind {
  BRANCH
  RELEASE
  TAG
}

enum SourceOperationKind {
  PUT
  DELETE
  MOVE
  ADD
  MODIFY
  RENAME
  COPY
  CHMOD
}

// Object IDs are SHA-256 over a type-prefixed byte sequence; payloads are immutable.
model SourceObject {
  id          String                @id @db.Char(64)
  kind        SourceObjectKind
  data        Bytes?                @db.ByteA
  externalId  String?               @unique @db.Char(64)
  external    StoredBlob?           @relation(fields: [externalId], references: [id], onDelete: Restrict)
  byteSize    BigInt
  createdAt   DateTime              @default(now())
  trees       SourceChangeset[]     @relation("ChangesetTree")
  operations  SourceFileOperation[] @relation("FileObject")
  grants      SourceObjectGrant[]
  importedBlobs GitImportBlob[]
  searchDocument SourceSearchDocument?
}

// Internal immutable radix nodes are not exposed as cross-repository objects.
// A repository-specific changeset root controls reachability and access.
model SourceSnapshotNode {
  id String @id @db.Char(64)
  data Bytes @db.ByteA
  createdAt DateTime @default(now())
  roots SourceSnapshotRoot[]
}

model SourceSnapshotRoot {
  changesetId String @id @db.Char(64)
  repositoryId String @db.Uuid
  rootId String @db.Char(64)
  createdAt DateTime @default(now())
  changeset SourceChangeset @relation(fields: [changesetId], references: [id], onDelete: Cascade)
  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Restrict)
  node SourceSnapshotNode @relation(fields: [rootId], references: [id], onDelete: Restrict)
  @@index([repositoryId, rootId])
}

// Resumable legacy migration bookkeeping. Never used as source-control authority.
model SourceSnapshotBuild {
  targetId     String   @id @db.Char(64)
  repositoryId String   @db.Uuid
  cursorId     String?  @db.Char(64)
  anchorId     String?  @db.Char(64)
  phase        String   @default("DISCOVER")
  discovered   Int      @default(0)
  applied      Int      @default(0)
  updatedAt    DateTime @updatedAt
  steps        SourceSnapshotBuildStep[]
  @@index([repositoryId, phase])
}

model SourceSnapshotBuildStep {
  targetId     String @db.Char(64)
  position     Int
  changesetId  String @db.Char(64)
  build        SourceSnapshotBuild @relation(fields: [targetId], references: [targetId], onDelete: Cascade)
  @@id([targetId, position])
  @@unique([targetId, changesetId])
  @@index([changesetId])
}

// Content-addressed changesets are never modified when references advance.
model SourceChangeset {
  review       SourceReview?
  id           String                  @id @db.Char(64)
  repositoryId String                  @db.Uuid
  treeId       String?                 @db.Char(64)
  authorId     String
  message      String
  createdAt    DateTime                @default(now())
  repository   Repository              @relation(fields: [repositoryId], references: [id])
  tree         SourceObject?           @relation("ChangesetTree", fields: [treeId], references: [id])
  parents      SourceChangesetParent[] @relation("ChangesetChild")
  children     SourceChangesetParent[] @relation("ChangesetParent")
  operations   SourceFileOperation[]
  validation   SourceValidation?
  approvals    SourceChangeApproval[]
  references   SourceReference[]
  snapshotRoot SourceSnapshotRoot?
  publicationKeys SourcePublicationKey[]
  publicationEvent SourceChangesetEvent?
  validationPipelines ValidationPipeline[] @relation("ValidationSubject")
  validationTargets ValidationPipeline[] @relation("ValidationTarget")
  queryIndexJob SourceQueryIndexJob?
  queryPathTouches SourceQueryPathTouch[]
  importedGitCommits GitImportCommit[]
  nativeReviews SourceReviewRequest[]
  integrations ChangeIntegration[] @relation("IntegrationSource")
  @@index([repositoryId, createdAt(sort: Desc)])
}

model SourceChangesetParent {
  changesetId String          @db.Char(64)
  parentId    String          @db.Char(64)
  position    Int
  child       SourceChangeset @relation("ChangesetChild", fields: [changesetId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  parent      SourceChangeset @relation("ChangesetParent", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  @@id([changesetId, parentId])
  @@unique([changesetId, position])
  @@index([parentId])
}

model SourceFileOperation {
  changesetId  String              @db.Char(64)
  path         String
  kind         SourceOperationKind
  previousPath String?
  objectId     String?             @db.Char(64)
  position     Int                 @default(0)
  fileMode     String?             @db.VarChar(6)
  changeset    SourceChangeset     @relation(fields: [changesetId], references: [id], onDelete: Cascade)
  object       SourceObject?       @relation("FileObject", fields: [objectId], references: [id])
  @@id([changesetId, path])
  @@index([path])
  @@index([previousPath])
}

// This is a manifest/integrity check, not a claim that contributed code was executed.
model SourceValidation {
  changesetId String          @id @db.Char(64)
  state       CheckState
  riskTier    RiskTier
  riskScore   Int
  touchedPaths String[]
  summary     String
  checkedAt   DateTime        @default(now())
  changeset   SourceChangeset @relation(fields: [changesetId], references: [id], onDelete: Cascade)
}

model SourceChangeApproval {
  changesetId String           @db.Char(64)
  userId      String           @db.Uuid
  decision    ApprovalDecision
  createdAt   DateTime         @default(now())
  changeset   SourceChangeset  @relation(fields: [changesetId], references: [id], onDelete: Cascade)
  user        User             @relation(fields: [userId], references: [id])
  @@id([changesetId, userId])
}


model SourceReference {
  repositoryId String          @db.Uuid
  name         String
  changesetId  String          @db.Char(64)
  generation   Int             @default(1)
  kind         SourceRefKind   @default(BRANCH)
  deletedAt    DateTime?
  updatedAt    DateTime        @updatedAt
  repository   Repository      @relation(fields: [repositoryId], references: [id])
  changeset    SourceChangeset @relation(fields: [changesetId], references: [id])
  @@id([repositoryId, name])
  @@index([changesetId])
}

model SourceReferencePolicy {
  repositoryId    String      @db.Uuid
  name            String
  protected       Boolean     @default(false)
  allowForce      Boolean     @default(false)
  allowDelete     Boolean     @default(true)
  requireApproval Boolean     @default(false)
  updatedAt       DateTime    @updatedAt
  repository      Repository  @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  @@id([repositoryId, name])
}

model SourceRefMutation {
  id             String        @id @default(uuid()) @db.Uuid
  repositoryId   String        @db.Uuid
  name           String
  mutationId     String        @db.VarChar(128)
  requestHash    String        @db.Char(64)
  operation      String        @db.VarChar(20)
  kind           SourceRefKind
  oldChangesetId String?       @db.Char(64)
  newChangesetId String?       @db.Char(64)
  oldGeneration  Int?
  newGeneration  Int
  actorType      String
  actorId        String
  forced         Boolean       @default(false)
  reason         String?
  createdAt      DateTime      @default(now())
  repository     Repository    @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  @@unique([repositoryId, name, mutationId])
  @@unique([repositoryId, name, newGeneration])
  @@index([repositoryId, name, createdAt(sort: Desc)])
}


// A repository-local grant permits staged blobs to be used in future changesets.
// Global SHA-256 deduplication never implies cross-repository read authorization.
model SourceObjectGrant {
  repositoryId String       @db.Uuid
  objectId     String       @db.Char(64)
  createdAt    DateTime     @default(now())
  repository   Repository   @relation(fields: [repositoryId], references: [id], onDelete: Restrict)
  object       SourceObject @relation(fields: [objectId], references: [id], onDelete: Restrict)
  @@id([repositoryId, objectId])
}

// Retry keys are immutable, scoped to both the repository and submitting actor.
model SourcePublicationKey {
  repositoryId String          @db.Uuid
  authorId     String
  key          String
  changesetId  String          @db.Char(64)
  createdAt    DateTime        @default(now())
  repository   Repository      @relation(fields: [repositoryId], references: [id], onDelete: Restrict)
  changeset    SourceChangeset @relation(fields: [changesetId], references: [id], onDelete: Restrict)
  @@id([repositoryId, authorId, key])
  @@index([changesetId])
}

// Recorded in the same PostgreSQL transaction as the complete changeset.
// Consumers must use idempotent processing; timestamp order is not commit order.
model SourceChangesetEvent {
  id           String          @id @default(uuid()) @db.Uuid
  repositoryId String          @db.Uuid
  changesetId  String          @unique @db.Char(64)
  kind         String
  payload      Json
  createdAt    DateTime        @default(now())
  repository   Repository      @relation(fields: [repositoryId], references: [id], onDelete: Restrict)
  changeset    SourceChangeset @relation(fields: [changesetId], references: [id], onDelete: Restrict)
  @@index([repositoryId, createdAt])
}

// Durable and recoverable lazy derived-data indexing. All canonical source
// changesets and their file operations remain the sole source of truth.
model SourceQueryIndexJob {
  changesetId  String          @id @db.Char(64)
  repositoryId String          @db.Uuid
  state        JobState        @default(QUEUED)
  generation   Int?
  attempts     Int             @default(0)
  nextAttemptAt DateTime       @default(now())
  leaseUntil   DateTime?
  leaseToken   String?         @db.Uuid
  lastError    String?
  indexedAt    DateTime?
  createdAt    DateTime        @default(now())
  changeset    SourceChangeset @relation(fields: [changesetId], references: [id], onDelete: Cascade)
  repository   Repository      @relation(fields: [repositoryId], references: [id])
  @@index([state, nextAttemptAt, leaseUntil])
  @@index([repositoryId, generation])
}

// Per-revision path touches include both sides of renames, unlike operations.
model SourceQueryPathTouch {
  changesetId    String          @db.Char(64)
  path           String
  operationPath  String
  role           String
  changeset      SourceChangeset @relation(fields: [changesetId], references: [id], onDelete: Cascade)
  @@id([changesetId, path, operationPath, role])
  @@index([path, changesetId])
}

// Staged S3 publication is separately tracked from immutable source-control trees.
// No byte payload is stored in these rows. READY means copy and verification finished.
enum BlobState {
  PUBLISHING
  READY
  DELETING
}
enum BlobTransferState {
  ACTIVE
  STAGED
  FINISHED
  FAILED
}
model StoredBlob {
  id               String        @id @db.Char(64)
  objectKey        String        @unique
  state            BlobState     @default(PUBLISHING)
  encoding         String        @db.VarChar(16)
  rawSha256        String        @db.Char(64)
  rawBytes         BigInt
  storedBytes      BigInt
  stagingKey       String?
  publisherId      String?       @db.Uuid
  publishLeaseUntil DateTime?
  retainUntil      DateTime
  createdAt        DateTime      @default(now())
  verifiedAt       DateTime?
  sourceObjects    SourceObject[]
  leases           BlobLease[]
  @@index([state, publishLeaseUntil])
  @@index([state, retainUntil])
}
model BlobLease {
  repositoryId String       @db.Uuid
  objectId     String       @db.Char(64)
  expiresAt    DateTime
  repository   Repository   @relation(fields: [repositoryId], references: [id], onDelete: Restrict)
  object       StoredBlob   @relation(fields: [objectId], references: [id], onDelete: Restrict)
  @@id([repositoryId, objectId])
  @@index([objectId, expiresAt])
}
model BlobTransfer {
  id           String             @id @default(uuid()) @db.Uuid
  repositoryId String             @db.Uuid
  stagingKey   String             @unique
  uploadId     String?
  state        BlobTransferState  @default(ACTIVE)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  repository   Repository         @relation(fields: [repositoryId], references: [id], onDelete: Restrict)
  @@index([state, updatedAt])
}

// Execution findings are separate from structural SourceValidation metadata.
enum ValidationExecutionState {
  QUEUED
  RUNNING
  PASSED
  FAILED
  ERRORED
  TIMED_OUT
  CANCELLED
}
enum ValidationKind {
  COMPILE
  TEST
  LINT
  SECURITY
  SECRETS
  DEPENDENCIES
}
model ValidationPipeline {
  id                String        @id @default(uuid()) @db.Uuid
  repositoryId      String        @db.Uuid
  changesetId       String        @db.Char(64)
  targetChangesetId String?       @db.Char(64)
  idempotencyKey    String
  requestedBy       String
  snapshotDigest    String        @db.Char(64)
  dependencyDigest  String        @db.Char(64)
  configurationDigest String      @db.Char(64)
  state             ValidationExecutionState @default(QUEUED)
  createdAt         DateTime      @default(now())
  finishedAt        DateTime?
  repository        Repository    @relation(fields: [repositoryId], references: [id], onDelete: Restrict)
  changeset         SourceChangeset @relation("ValidationSubject", fields: [changesetId], references: [id], onDelete: Restrict)
  targetChangeset   SourceChangeset? @relation("ValidationTarget", fields: [targetChangesetId], references: [id], onDelete: Restrict)
  tasks             ValidationTask[]
  @@unique([repositoryId, idempotencyKey])
  @@index([repositoryId, changesetId, createdAt(sort: Desc)])
}
model ValidationTask {
  id            String           @id @default(uuid()) @db.Uuid
  pipelineId    String           @db.Uuid
  kind          ValidationKind
  state         ValidationExecutionState @default(QUEUED)
  fingerprint   String           @db.Char(64)
  image         String
  command       String           @db.Text
  timeoutSeconds Int
  attempt       Int              @default(0)
  maxAttempts   Int              @default(3)
  nextAttemptAt DateTime         @default(now())
  leaseToken    String?          @db.Uuid
  leaseUntil    DateTime?
  runnerId      String?
  exitCode      Int?
  summary       String?
  logDigest     String?          @db.Char(64)
  artifactDigest String?         @db.Char(64)
  signature     String?          @db.Text
  reusedFromId  String?          @db.Uuid
  createdAt     DateTime         @default(now())
  startedAt     DateTime?
  finishedAt    DateTime?
  pipeline      ValidationPipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  logs          ValidationLogChunk[]
  artifacts     ValidationArtifact[]
  @@unique([pipelineId, kind])
  @@index([state, nextAttemptAt, leaseUntil])
  @@index([fingerprint, state])
}
model ValidationLogChunk {
  taskId     String         @db.Uuid
  attempt    Int
  sequence   Int
  content    String         @db.Text
  createdAt  DateTime       @default(now())
  task       ValidationTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  @@id([taskId, attempt, sequence])
}
model ValidationArtifact {
  id         String         @id @default(uuid()) @db.Uuid
  taskId     String         @db.Uuid
  attempt    Int
  name       String
  mediaType  String
  digest     String         @db.Char(64)
  content    Bytes          @db.ByteA
  createdAt  DateTime       @default(now())
  task       ValidationTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  @@unique([taskId, attempt, name])
}

enum GitImportStatus {
  QUEUED
  RUNNING
  VERIFY_QUEUED
  VERIFYING
  FAILED
  COMPLETED
}

model GitImportJob {
  id           String          @id @default(uuid()) @db.Uuid
  repositoryId String          @db.Uuid
  sourcePath   String
  authorizedUserId String? @db.Uuid
  authorizedSessionId String? @db.Uuid
  status       GitImportStatus @default(QUEUED)
  workerId     String?         @db.Uuid
  leaseUntil   DateTime?
  imported     Int             @default(0)
  lastGitSha   String?         @db.VarChar(64)
  lastError    String?         @db.Text
  verifiedAt   DateTime?
  startedAt    DateTime?
  completedAt  DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  repository   Repository      @relation(fields: [repositoryId], references: [id], onDelete: Restrict)
  @@unique([repositoryId, sourcePath])
  @@index([status, leaseUntil])
}

model GitImportCommit {
  repositoryId    String          @db.Uuid
  gitSha          String          @db.VarChar(64)
  changesetId     String          @db.Char(64)
  gitTreeSha      String          @db.VarChar(64)
  authorName      String
  authorEmail     String
  authorDate      DateTime
  authorTimezone  String          @db.VarChar(5)
  committerName   String
  committerEmail  String
  committerDate   DateTime
  committerTimezone String        @db.VarChar(5)
  createdAt       DateTime        @default(now())
  repository      Repository      @relation(fields: [repositoryId], references: [id], onDelete: Restrict)
  changeset       SourceChangeset @relation(fields: [changesetId], references: [id], onDelete: Restrict)
  @@id([repositoryId, gitSha])
  @@unique([repositoryId, changesetId])
}

model GitImportBlob {
  repositoryId String       @db.Uuid
  gitSha       String       @db.VarChar(64)
  objectId     String       @db.Char(64)
  repository   Repository   @relation(fields: [repositoryId], references: [id], onDelete: Restrict)
  object       SourceObject @relation(fields: [objectId], references: [id], onDelete: Restrict)
  @@id([repositoryId, gitSha])
}


model SourceReview {
  changesetId      String       @id @db.Char(64)
  repositoryId     String       @db.Uuid
  state            ReviewState  @default(QUEUED)
  fingerprint      String?      @db.Char(64)
  paths            String[]     @default([])
  regions          Json?
  findings         Json?
  related          Json?
  summary          String?      @db.Text
  groupKey         String?      @db.VarChar(64)
  exactDuplicateOf String?      @db.Char(64)
  riskTier         RiskTier?
  riskScore        Int?
  provider         String?
  model            String?
  confidence       Float?
  costMicros       BigInt       @default(0)
  latencyMs        Int?
  embedding        Json?
  equivalenceHash String?      @db.Char(64)
  candidateCount  Int          @default(0)
  relatedTruncated Boolean     @default(false)
  targetRevisionId String?     @db.Char(64)
  indexedAt       DateTime?
  signals         SourceReviewSignal[]
  intervals       SourceReviewRegion[]
  modelCalls      SourceReviewModelCall[]
  attempts         Int          @default(0)
  leaseUntil       DateTime?
  nextAttemptAt    DateTime     @default(now())
  error            String?
  startedAt        DateTime?
  completedAt      DateTime?
  createdAt        DateTime     @default(now())
  changeset        SourceChangeset @relation(fields: [changesetId], references: [id], onDelete: Cascade)
  @@index([state, nextAttemptAt, leaseUntil])
  @@index([repositoryId, state, createdAt(sort: Desc)])
  @@index([repositoryId, fingerprint])
  @@index([repositoryId, groupKey])
}

// Materialized repository-scoped inverted signals. Records are versioned and
// rebuilt from immutable authoritative changesets; a match is never an approval.
model SourceReviewSignal {
  repositoryId String @db.Uuid
  changesetId  String @db.Char(64)
  kind         String @db.VarChar(20)
  key          String @db.VarChar(128)
  review       SourceReview @relation(fields: [changesetId], references: [changesetId], onDelete: Cascade)
  @@id([changesetId, kind, key])
  @@index([repositoryId, kind, key, changesetId])
}

// Each changed line range is searchable without decoding every review JSON.
model SourceReviewRegion {
  id           BigInt @id @default(autoincrement())
  repositoryId String @db.Uuid
  changesetId  String @db.Char(64)
  path         String
  startLine    BigInt
  endLine      BigInt
  baseObject   String? @db.Char(64)
  review       SourceReview @relation(fields: [changesetId], references: [changesetId], onDelete: Cascade)
  @@index([repositoryId, path, startLine, endLine])
  @@index([changesetId])
}

model SourceReviewModelCall {
  id           String @id @default(uuid()) @db.Uuid
  changesetId  String @db.Char(64)
  operation    String
  provider     String
  model        String
  tokens       Int?
  costMicros   BigInt @default(0)
  latencyMs    Int
  succeeded    Boolean
  error        String?
  confidence   Float?
  createdAt    DateTime @default(now())
  review       SourceReview @relation(fields: [changesetId], references: [changesetId], onDelete: Cascade)
  @@index([changesetId, createdAt])
}

// Upload sessions are bounded and survive client or server restarts.
model SourceObjectUpload {
  repositoryId String @db.Uuid
  objectId String @db.Char(64)
  byteSize Int
  received Int @default(0)
  data Bytes @db.ByteA
  updatedAt DateTime @updatedAt
  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Restrict)
  @@id([repositoryId, objectId])
  @@index([updatedAt])
}

// A review request refers to a native immutable changeset, never a Git SHA.
model SourceReviewRequest {
  id String @id @default(uuid()) @db.Uuid
  repositoryId String @db.Uuid
  changesetId String @db.Char(64)
  targetRef String
  title String
  description String @default("")
  actorId String
  status String @default("OPEN")
  lastTargetRevisionId String? @db.Char(64)
  lastTargetCheckedAt DateTime?
  createdAt DateTime @default(now())
  repository Repository @relation(fields: [repositoryId], references: [id], onDelete: Restrict)
  changeset SourceChangeset @relation(fields: [changesetId], references: [id], onDelete: Restrict)
  @@unique([repositoryId, changesetId, targetRef])
  @@index([repositoryId, createdAt(sort: Desc)])
  @@index([status, id])
}

enum MembershipRole {
  OWNER
  ADMIN
  MEMBER
}

enum GrantEffect {
  ALLOW
  DENY
}

enum GrantSubject {
  USER
  TEAM
  AGENT
}

model Organization {
  id          String   @id @default(uuid()) @db.Uuid
  slug        String   @unique
  name        String
  createdAt   DateTime @default(now())
  maxRepositories Int @default(100)
  maxRequestsPerMinute Int @default(600)
  repositories Repository[]
  memberships OrganizationMembership[]
  teams       Team[]
}

model OrganizationMembership {
  organizationId String @db.Uuid
  userId         String @db.Uuid
  role           MembershipRole @default(MEMBER)
  joinedAt       DateTime @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([organizationId, userId])
  @@index([userId])
}

model Team {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  slug           String
  name           String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  members        TeamMembership[]
  @@unique([organizationId, slug])
}

model TeamMembership {
  teamId String @db.Uuid
  userId String @db.Uuid
  team   Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@id([teamId, userId])
}

model HumanSession {
  id        String @id @default(uuid()) @db.Uuid
  userId    String @db.Uuid
  tokenHash String @unique @db.Char(64)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, revokedAt])
}

model RepositoryGrant {
  id           String @id @default(uuid()) @db.Uuid
  repositoryId String @db.Uuid
  subjectType  GrantSubject
  subjectId    String @db.Uuid
  capability   String
  effect       GrantEffect @default(ALLOW)
  pathPrefix   String?
  branch       String?
  expiresAt    DateTime?
  createdAt    DateTime @default(now())
  repository   Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  @@index([repositoryId, subjectType, subjectId, capability])
}

model AgentDelegation {
  id           String @id @default(uuid()) @db.Uuid
  agentId      String @db.Uuid
  repositoryId String @db.Uuid
  delegatedBy  String @db.Uuid
  scopes       String[]
  pathPrefix   String?
  branch       String?
  expiresAt    DateTime
  revokedAt    DateTime?
  createdAt    DateTime @default(now())
  agent        AgentIdentity @relation(fields: [agentId], references: [id], onDelete: Cascade)
  repository   Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  @@index([agentId, repositoryId, revokedAt])
}

model ApiRateBucket {
  repositoryId String @db.Uuid
  actorKey     String
  windowStart  DateTime
  count        Int @default(0)
  repository   Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  @@id([repositoryId, actorKey, windowStart])
}

model LoginRateBucket {
  key String @db.Char(64)
  windowStart DateTime
  count Int @default(0)
  @@id([key, windowStart])
}

 
// Integration preparation is concurrent; only the final guarded ref CAS is serialized.
model ChangeIntegration {
  id                   String   @id @default(uuid()) @db.Uuid
  repositoryId         String   @db.Uuid
  sourceChangesetId    String   @db.Char(64)
  targetRef            String
  requestKey           String   @db.VarChar(128)
  mode                 String   @default("MERGE")
  revertIntegrationId  String?  @db.Uuid
  resolutionOfId       String?  @db.Uuid
  state                String   @default("QUEUED")
  actorType            String
  actorId              String
  actorSessionId       String?  @db.Uuid
  actorCredentialId    String?  @db.Uuid
  targetChangesetId    String?  @db.Char(64)
  baseChangesetId      String?  @db.Char(64)
  resultChangesetId    String?  @db.Char(64)
  targetGeneration     Int?
  attempts             Int      @default(0)
  maxAttempts          Int      @default(8)
  leaseToken           String?  @db.Uuid
  leaseUntil           DateTime?
  nextAttemptAt        DateTime @default(now())
  affectedPaths        String[] @default([])
  conflicts            Json?
  lastError            String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  completedAt          DateTime?
  repository Repository @relation(fields:[repositoryId],references:[id],onDelete:Restrict)
  sourceChangeset SourceChangeset @relation("IntegrationSource",fields:[sourceChangesetId],references:[id],onDelete:Restrict)
  @@unique([repositoryId, requestKey])
  @@index([state, nextAttemptAt, leaseUntil])
  @@index([repositoryId, targetRef, createdAt(sort: Desc)])
}
model IntegrationPolicy {
  repositoryId           String @db.Uuid
  repository             Repository @relation(fields:[repositoryId],references:[id],onDelete:Cascade)
  targetRef              String
  preChecks              Boolean @default(true)
  targetChecks           Boolean @default(true)
  postChecks             Boolean @default(true)
  deploymentChecks       Boolean @default(true)
  maxRetries             Int @default(8)
  updatedAt              DateTime @updatedAt
  @@id([repositoryId, targetRef])
}


// Durable production deployment command and authenticated completion receipts.
model DeploymentExecution {
  id String @id @default(uuid()) @db.Uuid
  repositoryId String @db.Uuid
  integrationId String @db.Uuid
  revisionId String @db.Char(64)
  environment String @db.VarChar(80)
  requestKey String @db.VarChar(128)
  state String @default("QUEUED")
  actorId String @db.Uuid
  actorSessionId String @db.Uuid
  attempts Int @default(0)
  maxAttempts Int @default(5)
  leaseToken String? @db.Uuid
  leaseUntil DateTime?
  nextAttemptAt DateTime @default(now())
  dispatchedAt DateTime?
  completedAt DateTime?
  receipt Json?
  lastError String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  repository Repository @relation(fields:[repositoryId],references:[id],onDelete:Restrict)
  @@unique([repositoryId,environment,requestKey])
  @@index([state,nextAttemptAt,leaseUntil])
}


// Immutable content is indexed once per SHA-256 object, independently of branch pointers.
// Per-revision path visibility is always evaluated from an authorized source snapshot.
model SourceSearchDocument {
  objectId String @id @db.Char(64)
  state JobState @default(QUEUED)
  textBody String? @db.Text
  excludedReason String? @db.VarChar(32)
  attempts Int @default(0)
  nextAttemptAt DateTime @default(now())
  leaseUntil DateTime?
  leaseToken String? @db.Uuid
  lastError String?
  indexedAt DateTime?
  object SourceObject @relation(fields: [objectId], references: [id], onDelete: Cascade)
  @@index([state, nextAttemptAt, leaseUntil])
}

// Git objects are disposable projections of native changesets, never a second source of truth.
model GitInteropCommit {
  repositoryId String @db.Uuid
  changesetId  String @db.Char(64)
  gitSha       String @db.Char(40)
  treeSha      String @db.Char(40)
  rawCommit    Bytes? @db.ByteA
  createdAt    DateTime @default(now())
  @@id([repositoryId, changesetId])
  @@unique([repositoryId, gitSha])
}

model GitInteropBlob {
  repositoryId String @db.Uuid
  objectId     String @db.Char(64)
  gitSha       String @db.Char(40)
  @@id([repositoryId, objectId])
  @@unique([repositoryId, gitSha])
}

model GitInteropCredential {
  id           String @id @default(uuid()) @db.Uuid
  repositoryId String @db.Uuid
  userId       String @db.Uuid
  tokenHash    String @unique @db.Char(64)
  scopes       String[]
  expiresAt    DateTime
  revokedAt    DateTime?
  createdAt    DateTime @default(now())
  lastUsedAt   DateTime?
  @@index([repositoryId, userId])
}


/// Rebuildable, non-authoritative indexes keyed to immutable changeset identity.
/// A published SUCCEEDED row is immutable; obsolete versions remain readable only
/// for diagnostics. A worker lease only authorizes publication, never source edits.
model SourceDerivedIndex {
  repositoryId  String    @db.Uuid
  changesetId   String    @db.Char(64)
  kind          String    @db.VarChar(32)
  version       Int
  state         String    @default("QUEUED") @db.VarChar(16)
  payload       Json?
  checksum      String?   @db.Char(64)
  leaseToken    String?   @db.Uuid
  leaseUntil    DateTime?
  nextAttemptAt DateTime  @default(now())
  attempts      Int       @default(0)
  lastError     String?
  finishedAt    DateTime?
  createdAt     DateTime  @default(now())
  @@id([changesetId, kind, version])
  @@index([state, nextAttemptAt, leaseUntil])
  @@index([repositoryId, kind, version, state])
}

/// Binary lifting over immutable first-parent edges. One row per power of two.
model SourceDerivedJump {
  repositoryId String @db.Uuid
  changesetId  String @db.Char(64)
  version      Int
  level        Int
  ancestorId   String @db.Char(64)
  @@id([changesetId, version, level])
  @@index([repositoryId, ancestorId])
}

/// Sparse changed-path postings; no per-revision copy of the path namespace.
model SourceDerivedPathEvent {
  repositoryId  String @db.Uuid
  changesetId   String @db.Char(64)
  version       Int
  position      Int
  role          String @db.VarChar(16)
  path          String
  generation    Int
  kind          String @db.VarChar(16)
  previousPath  String?
  objectId      String? @db.Char(64)
  @@id([changesetId, version, position, role])
  @@index([repositoryId, version, path, generation(sort: Desc)])
  @@index([repositoryId, changesetId])
}


/// Sparse line-provenance state for changed text files only, never snapshots
/// of the entire path namespace. UNAVAILABLE forces canonical blame fallback.
model SourceDerivedBlameFile {
  repositoryId String @db.Uuid
  changesetId  String @db.Char(64)
  version      Int
  position     Int
  path         String
  generation   Int
  objectId     String @db.Char(64)
  state        String @db.VarChar(16)
  lineCount    Int
  spans        Json?
  checksum     String? @db.Char(64)
  @@id([changesetId, version, position])
  @@index([repositoryId, version, path, generation(sort: Desc)])
}

// Exclusive, renewable gateway session; never stores authoritative Git refs.
model GitGatewayLease {
  repositoryId String   @id @db.Uuid
  token        String   @db.Uuid
  expiresAt    DateTime
  updatedAt    DateTime @default(now())
  @@index([expiresAt])
}

// Shared tenant-wide API admission buckets: one atomic counter across replicas
// and repositories, never per-process Redis memory.
model TenantRateBucket {
  tenantId    String   @db.Uuid
  windowStart DateTime
  count       Int      @default(0)
  @@id([tenantId, windowStart])
  @@index([windowStart])
}

// Measured bytes observed at the Git gateway boundary. Not an estimate of
// S3, CDN, cache or provider-billed traffic.
model GitTrafficUsage {
  repositoryId String   @db.Uuid
  day          DateTime @db.Date
  ingressBytes BigInt   @default(0)
  egressBytes  BigInt   @default(0)
  updatedAt    DateTime @updatedAt
  @@id([repositoryId, day])
  @@index([day])
}
